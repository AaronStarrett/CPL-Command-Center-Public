{
  "name": "@bea/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./cpl-gmail": {
      "types": "./src/cpl-gmail.ts",
      "default": "./src/cpl-gmail.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bea/domain": "workspace:*",
    "@bea/platform": "workspace:*"
  }
}
