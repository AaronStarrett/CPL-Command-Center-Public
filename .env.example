# Production-intended configuration example; no identities, secrets or business records.
# This checkpoint still blocks customer runtime until hosted authentication and
# operational tenant isolation are implemented. Start-CPL uses its own empty setup profile.
BEA_RUNTIME_MODE=production
APP_MODE=production
APP_BASE_URL=https://workspace.example.invalid
DATABASE_DRIVER=postgres
DATABASE_URL=
DEMO_AUTH_ENABLED=false
SESSION_SECRET=
SESSION_TTL_MINUTES=480
WORKER_MODE=serve
WORKER_QUEUE_ADAPTER=pg-boss
WORKER_POLL_INTERVAL_MS=60000
LOG_LEVEL=info

# Put actual configuration only in an approved private runtime secret store.
# Automated tests supply their isolated synthetic configuration explicitly.

# Next selects PORT before repository runtime configuration loads. Set a
# non-default PORT in the launching shell and keep APP_BASE_URL aligned.
WORKER_HEALTH_PORT=3001
