{
  "name": "@bea/artifacts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./brand": {
      "types": "./src/brand.ts",
      "default": "./src/brand.ts"
    },
    "./proposal-pdf": {
      "types": "./src/proposal-pdf.ts",
      "default": "./src/proposal-pdf.ts"
    },
    "./cpl-evidence-store": {
      "types": "./src/cpl-evidence-store.ts",
      "default": "./src/cpl-evidence-store.ts"
    },
    "./cpl-image": {
      "types": "./src/cpl-image.ts",
      "default": "./src/cpl-image.ts"
    },
    "./cpl-photo-annotations": {
      "types": "./src/cpl-photo-annotations.ts",
      "default": "./src/cpl-photo-annotations.ts"
    },
    "./cpl-report-pdf": {
      "types": "./src/cpl-report-pdf.ts",
      "default": "./src/cpl-report-pdf.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bea/domain": "workspace:*",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.4"
  }
}
