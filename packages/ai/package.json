{
  "name": "@bea/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./presentation": {
      "types": "./src/presentation.ts",
      "default": "./src/presentation.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "beaRuntimeRequirements": {
    "demo": {
      "node": ">=20.9.0"
    },
    "liveOpenAi": {
      "node": ">=22.0.0",
      "verifiedNode": "24.19.0"
    }
  },
  "dependencies": {
    "@bea/domain": "workspace:*",
    "openai": "7.4.0"
  }
}
