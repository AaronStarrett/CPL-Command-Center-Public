{
  "name": "@bea/security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./hosted": {
      "types": "./src/hosted.ts",
      "default": "./src/hosted.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bea/domain": "workspace:*",
    "jose": "6.2.12",
    "@simplewebauthn/server": "14.0.2"
  }
}
