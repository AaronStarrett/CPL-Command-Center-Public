    "ci:phase1.1": "pnpm source:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:component && pnpm test:integration && pnpm db:migrate && pnpm db:seed && pnpm db:seed && pnpm demo:reset && pnpm db:seed && pnpm smoke:worker && pnpm build && pnpm smoke:web && pnpm security:audit && pnpm security:secrets && pnpm inventory:verify",
