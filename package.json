    "ci:phase1.3.1": "pnpm verify:phase1.3.1",
    "ci:phase1.3.2": "pnpm ci:phase1.2",
    "ci:phase1.3.4": "pnpm verify:phase1.3.4",
    "ci:phase1.3.5": "pnpm source:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit:phase1.3.5 && pnpm test:integration && pnpm security:audit && pnpm security:secrets && pnpm security:history && pnpm repository:health && pnpm deployment:validate && pnpm inventory:verify",
    "ci": "pnpm ci:phase1.3.5",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "precommit:verify": "node scripts/pre-commit-verify.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
