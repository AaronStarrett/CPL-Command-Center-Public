FROM node:24.19.0-bookworm-slim AS build

RUN npm install --global pnpm@11.19.0
WORKDIR /workspace
COPY . .
ENV APP_MODE=demo \
    BEA_DISABLE_ENV_FILE=true \
    BEA_REPOSITORY_ROOT=/workspace \
    CI=true \
    DATABASE_DRIVER=pglite \
    DEMO_AUTH_ENABLED=true \
    OPENAI_API_KEY= \
    WORKER_DEMO_DATABASE_PATH=memory://
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @bea/worker build

FROM node:24.19.0-bookworm-slim AS runtime
RUN npm install --global pnpm@11.19.0
WORKDIR /workspace
COPY --chown=node:node --from=build /workspace /workspace
ENV BEA_DISABLE_ENV_FILE=true \
    BEA_REPOSITORY_ROOT=/workspace \
    CI=true \
    APP_MODE=demo \
    DATABASE_DRIVER=pglite \
    DEMO_AUTH_ENABLED=true \
    OPENAI_API_KEY= \
    WORKER_DEMO_DATABASE_PATH=memory:// \
    WORKER_HEALTH_PORT=3001 \
    WORKER_MODE=serve \
    WORKER_QUEUE_ADAPTER=inline
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "const p=process.env.WORKER_HEALTH_PORT||3001;fetch('http://127.0.0.1:'+p+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["pnpm", "--filter", "@bea/worker", "start"]
